# ==============================================================================
# AgroSaathi - Environment Configuration (.env.example)
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_NAME="AgroSaathi"
NEXT_PUBLIC_APP_DESCRIPTION="Smart Farming, Brighter Futures"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (Neon PostgreSQL)
# For pooled connection in serverless runtime:
DATABASE_URL="postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/krishisetu?sslmode=require&pgbouncer=true"
# For direct connection (used by Prisma migrate/push):
DIRECT_URL="postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/krishisetu?sslmode=require"

# Note: The application operates gracefully in offline/mock mode if DATABASE_URL is not set.

# Google Gemini AI Assistant (Free Tier)
# Get your free key from https://aistudio.google.com/
# Leave blank to run AgroSaathi in built-in offline ICAR knowledge engine mode.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Plant Disease Classification Inference API (PyTorch ResNet50-DCBAM)
# Server-only URL to Python FastAPI inference backend (defaults to http://127.0.0.1:8000)
PLANT_DISEASE_API_URL="http://127.0.0.1:8000"
