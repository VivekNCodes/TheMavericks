# ==============================================================================
# AgroSaathi - Environment Configuration (.env.example)
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# Application Configuration
NEXT_PUBLIC_APP_NAME="AgroSaathi"
NEXT_PUBLIC_APP_DESCRIPTION="Smart Farming, Brighter Futures"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth.js Authentication & Google OAuth
# Local: http://localhost:3000
# Production: https://your-deployment.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-generated-random-32-byte-secret"

# Google Cloud OAuth 2.0 Credentials
# Create at https://console.cloud.google.com/apis/credentials
# Authorized Javascript origins:
#   - http://localhost:3000
#   - https://your-deployment.vercel.app
# Authorized redirect URIs:
#   - http://localhost:3000/api/auth/callback/google
#   - https://your-deployment.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Database Configuration (Neon PostgreSQL)
# For pooled connection in serverless runtime:
DATABASE_URL="postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/krishisetu?sslmode=require&pgbouncer=true"
# For direct connection (used by Prisma migrate/push):
DIRECT_URL="postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/krishisetu?sslmode=require"

# Note: The application operates gracefully in offline/mock mode if DATABASE_URL is not set.

# Google Gemini AI Assistant (Free Tier)
# Get your free key from https://aistudio.google.com/
# Leave blank to run AgroSaathi in built-in offline ICAR knowledge engine mode.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Government Mandi Prices API (data.gov.in)
# Official Dataset: https://www.data.gov.in/resource/current-daily-price-various-commodities-various-markets-mandi
# Resource ID: 9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_API_KEY=""

# Vercel Scheduled Cron Protection Secret
# Used to authenticate automated daily Mandi price ingestion (/api/mandi-prices/cron)
CRON_SECRET=""

# Plant Disease Classification Inference API (PyTorch ResNet50-DCBAM)
# Local development default: http://127.0.0.1:53147
# Deployed Vercel production: Set to your secure HTTPS tunnel URL (e.g., Cloudflare Tunnel / ngrok)
PLANT_DISEASE_API_URL="http://127.0.0.1:53147"

# Optional Secret Key for Tunnel/Endpoint Security
# If set on both Next.js and FastAPI server, requests must match this key in 'X-Api-Key'.
# Protects your local machine when exposed via Cloudflare Tunnel or ngrok to Vercel.
# Leave blank for open local development on 127.0.0.1.
PLANT_DISEASE_API_KEY=""
