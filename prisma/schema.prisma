// AgroSaathi - Prisma Schema
// Database Engine: Neon Serverless PostgreSQL

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// User & Farmer Profiles
// ------------------------------------------------------
enum UserRole {
  FARMER
  BUYER
  AGRONOMIST
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  googleId          String?   @unique
  email             String?   @unique
  phone             String?   @unique
  fullName          String
  preferredName     String?
  preferredLanguage String    @default("en")
  role              UserRole  @default(FARMER)
  state             String    @default("Rajasthan")
  district          String    @default("Jaipur")
  village           String?
  farmSize          Float?
  farmSizeUnit      String    @default("acre")
  soilType          String?
  irrigationMethod  String?
  farmingExperience Int?
  avatarUrl         String?
  isVerified        Boolean   @default(false)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  crops        CropProfile[]
  diseaseLogs  DiseaseLog[]
  listings     MarketplaceListing[]
  inquiries    MarketplaceInquiry[]
  orders       MarketplaceOrder[]
  cropPlans    CropPlan[]
  chatSessions ChatSession[]
  consultations ConsultationCase[]

  @@map("users")
}

// ------------------------------------------------------
// Crop Profiles (Dashboard: "Your Crops")
// ------------------------------------------------------
enum GrowthStage {
  SOWING
  VEGETATIVE
  FLOWERING
  FRUIT_DEVELOPMENT
  GRAIN_FILLING
  MATURITY
  HARVESTED
}

model CropProfile {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropName            String // e.g. "Tomato", "Wheat", "Chili"
  variety             String? // e.g. "Abhinav F1", "HD-2967"
  acreage             Float // e.g. 1.2
  growthStage         GrowthStage @default(VEGETATIVE)
  sowingDate          DateTime?
  expectedHarvestDate DateTime?
  fieldLocation       String? // e.g. "Plot 2 - Jaipur North"
  soilType            String?
  irrigationType      String?
  fertilizerNotes     String?
  notes               String?
  imageUrl            String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  diseaseLogs    DiseaseLog[]
  irrigationLogs IrrigationLog[]

  @@index([userId])
  @@map("crop_profiles")
}

// ------------------------------------------------------
// Module 1: Crop Disease Detection
// ------------------------------------------------------
enum SeverityLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model DiseaseLog {
  id               String        @id @default(cuid())
  userId           String?
  user             User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cropProfileId    String?
  cropProfile      CropProfile?  @relation(fields: [cropProfileId], references: [id], onDelete: SetNull)
  imageUrl         String
  detectedDisease  String // e.g. "Tomato - Early Blight"
  scientificName   String? // e.g. "Alternaria solani"
  confidence       Float // 0.0 - 1.0 (e.g. 0.92)
  severity         SeverityLevel @default(MODERATE)
  symptoms         String?
  treatmentSummary String?
  chemicalRemedy   String? // e.g. "Mancozeb 75 WP"
  organicRemedy    String? // e.g. "Neem oil spray (3ml/L)"
  culturalControl  String? // e.g. "Remove bottom leaves, improve airflow"
  createdAt        DateTime      @default(now())

  @@index([userId, createdAt])
  @@map("disease_logs")
}

// ------------------------------------------------------
// Module 2: Mandi Price Intelligence
// ------------------------------------------------------
model MandiPrice {
  id             String   @id @default(cuid())
  mandiName      String // e.g. "Jaipur Mandi"
  state          String   @default("Uttar Pradesh")
  district       String   @default("Agra")
  cropName       String // e.g. "Potato", "Wheat"
  variety        String?  @default("Common")
  grade          String?  @default("FAQ")
  minPrice       Float // in INR per Quintal
  modalPrice     Float // in INR per Quintal
  maxPrice       Float // in INR per Quintal
  priceUnit      String   @default("INR/Quintal")
  arrivalsTonnes Float? // e.g. 1250
  trendPercent   Float? // e.g. +12.0
  source         String   @default("data.gov.in")
  recordDate     DateTime @default(now()) // official reporting date
  recordHash     String?  @unique // deterministic hash for idempotent deduplication
  fetchedAt      DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([state, district, cropName])
  @@index([cropName, recordDate])
  @@index([mandiName, cropName, recordDate])
  @@map("mandi_prices")
}

model MandiSyncLog {
  id              String    @id @default(cuid())
  source          String    @default("data.gov.in")
  status          String // "SUCCESS" | "FAILED" | "PARTIAL"
  recordsFetched  Int       @default(0)
  recordsInserted Int       @default(0)
  recordsUpdated  Int       @default(0)
  message         String?
  errorDetails    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([startedAt])
  @@map("mandi_sync_logs")
}

// ------------------------------------------------------
// Module 3: Smart Irrigation Advisor
// ------------------------------------------------------
enum IrrigationUrgency {
  NO_ACTION_NEEDED
  LOW
  MODERATE
  URGENT
}

model IrrigationLog {
  id                 String            @id @default(cuid())
  cropProfileId      String?
  cropProfile        CropProfile?      @relation(fields: [cropProfileId], references: [id], onDelete: SetNull)
  soilType           String // e.g. "Loamy", "Clay", "Sandy"
  growthStage        GrowthStage
  lastIrrigatedDate  DateTime?
  recommendationText String // e.g. "Consider irrigation in next 2-3 days"
  urgency            IrrigationUrgency @default(MODERATE)
  soilMoistureEst    Float? // e.g. 42%
  weatherJson        Json?
  createdAt          DateTime          @default(now())

  @@map("irrigation_logs")
}

// ------------------------------------------------------
// Module 4: Farmer Marketplace
// ------------------------------------------------------
enum ListingStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
  CANCELLED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

model MarketplaceListing {
  id              String        @id @default(cuid())
  userId          String
  farmer          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String // e.g. "Fresh Tomatoes - High Quality"
  cropName        String // e.g. "Tomato"
  category        String        @default("Vegetables") // Vegetables, Grains & Cereals, Fruits, Pulses, Spices, Oilseeds
  variety         String?
  description     String?
  unit            String        @default("quintal") // kg, quintal, tonne
  pricePerUnit    Float // Price in INR per specified unit
  totalStock      Float // Total initial stock listed
  availableStock  Float // Remaining uncommitted stock
  quantityKg      Float // Total equivalent quantity in kg for cross-mandi comparison
  pricePerQuintal Float // Normalized price per quintal for mandi comparison
  grade           String        @default("A Grade")
  state           String        @default("Rajasthan")
  district        String        @default("Jaipur")
  village         String?
  location        String        @default("Jaipur, Rajasthan")
  pickupDelivery  String        @default("Farmgate Pickup & Seller Delivery Available")
  sellerName      String        @default("Ramesh Kumar")
  sellerPhone     String        @default("+91 98765 43210")
  sellerWhatsapp  String        @default("+919876543210")
  sellerEmail     String?
  harvestDate     DateTime?
  status          ListingStatus @default(ACTIVE)
  images          String[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  inquiries MarketplaceInquiry[]
  orders    MarketplaceOrder[]

  @@index([cropName, status, state, district])
  @@map("marketplace_listings")
}

model MarketplaceInquiry {
  id                   String             @id @default(cuid())
  listingId            String
  listing              MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId              String?
  buyer                User?              @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName            String // e.g. "GreenFresh Traders"
  buyerOrg             String? // e.g. "AgriMart Pvt. Ltd."
  interestedQuantityKg Float // e.g. 500
  proposedPriceQuintal Float?
  message              String?
  status               String             @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt            DateTime           @default(now())

  @@map("marketplace_inquiries")
}

model MarketplaceOrder {
  id                 String             @id @default(cuid())
  listingId          String
  listing            MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId            String?
  buyer              User?              @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerName          String
  buyerPhone         String
  buyerWhatsapp      String
  buyerEmail         String?
  buyerAddress       String?
  quantityRequested  Float
  unit               String             @default("quintal")
  unitPrice          Float
  totalPrice         Float
  deliveryPreference String             @default("Farmgate Pickup")
  notes              String?
  status             OrderStatus        @default(PENDING)
  statusHistory      Json // Array of { status, timestamp, actor, note }
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([listingId, status])
  @@map("marketplace_orders")
}

// ------------------------------------------------------
// Module 5: Crop Growing Planner
// ------------------------------------------------------
model CropPlan {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  farmerName       String   @default("Guest Farmer")
  cropName         String
  cropId           String
  locationName     String
  sowingDate       DateTime
  landArea         Float
  areaUnit         String   @default("acre")
  soilType         String
  irrigationMethod String
  planData         Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
  @@map("crop_plans")
}

// ------------------------------------------------------
// Module 6: AI Chat Assistant Sessions
// ------------------------------------------------------
model ChatSession {
  id         String   @id @default(cuid())
  userId     String?
  farmerName String   @default("Guest Farmer")
  title      String   @default("New Farming Chat")
  language   String   @default("en")
  messages   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("chat_sessions")
}

// ------------------------------------------------------
// Module 7: Mavericks Expert Connect
// ------------------------------------------------------
enum ConsultationStatus {
  DRAFT
  PENDING
  ACCEPTED
  IN_PROGRESS
  RESPONDED
  RESOLVED
  DECLINED
  CANCELLED
}

enum ExpertStance {
  AGREES
  MODIFIES
  DISAGREES
}

model AgriculturalExpert {
  id               String   @id @default(cuid())
  fullName         String
  designation      String   // e.g. "Senior Plant Pathologist"
  institution      String   // e.g. "ICAR - Rajasthan Agricultural Research Institute (RARI)"
  specializations  String[] // e.g. ["Crop Pathology", "Fungicides", "Tomato Blight"]
  languages        String[] // e.g. ["Hindi", "English", "Rajasthani"]
  state            String   @default("Rajasthan")
  district         String   @default("Jaipur")
  experienceYears  Int      @default(12)
  avatarUrl        String?
  isVerified       Boolean  @default(true)
  rating           Float    @default(4.9)
  totalCasesSolved Int      @default(320)
  availability     String   @default("Available Today")
  bio              String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cases            ConsultationCase[]

  @@map("agricultural_experts")
}

model ConsultationCase {
  id                  String             @id // Format: EXP-2026-XXXX
  userId              String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  farmerName          String             @default("Guest Farmer")
  farmerPhone         String?
  farmerLocation      String             @default("Jaipur, Rajasthan")
  preferredLanguage   String             @default("en")

  cropName            String             // e.g. "Tomato"
  growthStage         String?            // e.g. "Vegetative", "Flowering"
  consultationReason  String             // e.g. "Verify AI Recommendation"
  symptomsDescription String             // Farmer problem text
  symptomDuration     String?            // e.g. "3-5 days"
  imageUrls           String[]           // Array of data URLs or image paths

  // AI Recommendation Snapshot (preserved at time of request)
  aiSource            String?            // "assistant" | "crop-disease" | "none"
  aiRecommendation    String?            // Text of AI advice
  aiReasoning         String?            // ICAR grounding citations / symptoms
  aiConfidence        Float?             // Genuine model confidence percentage (e.g. 88.0)

  // Supporting Farm Telemetry Snapshot
  weatherSnapshot     Json?              // Temp, humidity, rain forecast
  soilType            String?            // e.g. "Sandy Loam"
  irrigationStatus    String?            // e.g. "Irrigated 2 days ago"

  // Approved Report Snapshot
  approvedReport      Json?              // Farmer approved case snapshot
  farmerConsentAt     DateTime?

  // Assigned Expert
  expertId            String
  expert              AgriculturalExpert @relation(fields: [expertId], references: [id], onDelete: Restrict)

  // Status and Timeline
  status              ConsultationStatus @default(PENDING)
  submittedAt         DateTime           @default(now())
  acceptedAt          DateTime?
  respondedAt         DateTime?
  resolvedAt          DateTime?

  // Expert Response
  expertStance        ExpertStance?      // AGREES | MODIFIES | DISAGREES
  expertAdvice        String?            // Detailed agronomic response
  actionSteps         String[]           // Numbered recommended steps
  precautions         String[]           // Chemical / environmental precautions
  followUpNote        String?

  // Farmer Feedback
  feedbackRating      Int?               // 1 to 5
  feedbackHelpful     Boolean?
  feedbackComment     String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([userId, status, createdAt])
  @@index([expertId, status])
  @@map("consultation_cases")
}

